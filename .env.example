# Salin file ini jadi .env, lalu isi nilainya:
#   cp .env.example .env && chmod 600 .env
#
# SEMUA key di bawah OPSIONAL. Pipeline tetap jalan tanpa satu pun key:
# tanpa VO, tanpa katalog BGM HeyGen, pakai SFX bawaan shared/sfx/.
# Jangan pernah commit file .env — sudah masuk .gitignore.

# ── Voiceover bahasa Indonesia (Cartesia TTS) ────────────────────────────────
# Ambil di https://play.cartesia.ai/keys (format: sk_car_...)
# Kosong → mode tanpa VO: teks di layar + BGM + SFX.
CARTESIA_API_KEY=

# ── BGM dari katalog musik HeyGen ────────────────────────────────────────────
# Alternatif tanpa key: npx hyperframes auth login (OAuth, free plan).
# Kosong → set audio_request.json "bgm.mode": "generate" (Lyria/MusicGen lokal),
#          atau taruh sendiri assets/bgm/track.mp3.
HEYGEN_API_KEY=

# ── Generate BGM tanpa HeyGen (opsional) ─────────────────────────────────----
# Dipakai jalur "bgm.mode": "generate" → Lyria. Butuh google-genai (pip).
GEMINI_API_KEY=

# ── Jangan diisi di file ini ────────────────────────────────────────────────
# Variabel berikut dipakai sebagai env shell, bukan .env, dan bukan rahasia:
#   PRODUCER_LOW_MEMORY_MODE=false      # wajib untuk render normal
#   PUPPETEER_EXECUTABLE_PATH=$(which chromium)   # kalau "Chrome not found"
